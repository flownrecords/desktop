{
  "name": "flownrecords",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "description": "The application to access the Flown Records Platform via your desktop.",
  "author": {
    "name": "Jürgen Jacobsen"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:electron",
    "dev:electron": "npm run transpile:electron && cross-env NODE_ENV=development electron .",
    "transpile:electron": "tsc --project src/electron/tsconfig.json",
    "dist:mac": "npm run transpile:electron && electron-builder --mac --arm64",
    "dist:win": "npm run transpile:electron && electron-builder --win --x64",
    "dist:linux": "npm run transpile:electron && electron-builder --linux --x64",
    "publish:win": "npx dotenv-cli -- npm run dist:win && electron-builder --publish=always --win --x64"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@types/discord-rpc": "^4.0.10",
    "@types/node": "^24.10.1",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12",
    "globals": "^16.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "~5.8.3"
  }
}
